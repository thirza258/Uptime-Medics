# Copy to `.env` and adjust. Every value is optional except JWT_SECRET for production.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Signs session cookies. Use a long random string (e.g. `openssl rand -hex 32`).
# If unset, a random secret is generated at start-up and all sessions reset on restart.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Host port published by docker compose (the container itself always listens on 8080).
APP_PORT=8080

# Public URL of this deployment. Used for links in alert emails; an https:// value also
# turns on the Secure flag for the session cookie (override with COOKIE_SECURE).
#PUBLIC_BASE_URL=https://status.example.com
#COOKIE_SECURE=false

# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
#TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# SMTP alerting (alerts are disabled while SMTP_HOST is empty)
# ---------------------------------------------------------------------------
#SMTP_HOST=smtp.mailgun.org
#SMTP_PORT=587
#SMTP_USERNAME=postmaster@mg.example.com
#SMTP_PASSWORD=secret
#SMTP_FROM_ADDRESS="Uptime Medics <alerts@example.com>"
# starttls (default for 587) | tls (default for 465) | none (unencrypted local relay)
#SMTP_TLS=starttls

# Local testing with Mailpit (docker compose --profile dev up -d):
#SMTP_HOST=mailpit
#SMTP_PORT=1025
#SMTP_TLS=none
#SMTP_FROM_ADDRESS=alerts@uptime-medics.local

# ---------------------------------------------------------------------------
# Tuning (defaults shown)
# ---------------------------------------------------------------------------
#RUST_LOG=info
#PROBE_CONCURRENCY=100
#SCHEDULER_TICK_MS=1000
#LOG_FLUSH_INTERVAL_SECONDS=5
#LOG_BATCH_SIZE=100
# Keep at least 720 hours / 30 days for the full history view.
#ANON_LOG_RETENTION_HOURS=720
#REGISTERED_LOG_RETENTION_DAYS=30
#ANON_RATE_LIMIT_PER_HOUR=10
#SESSION_TTL_HOURS=168
# Allow monitoring private/LAN/loopback targets (disables SSRF protection; self-hosted LAN use only).
#ALLOW_PRIVATE_TARGETS=false
# Comma-separated list of extra browser origins allowed to call the API.
#CORS_ALLOWED_ORIGINS=
